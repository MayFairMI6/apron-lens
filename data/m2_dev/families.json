{
 "version": "m2-dev-v1",
 "split": "development",
 "note": "Development families for the M2 camera comparison (docs/course/CAMERA_EVIDENCE_COMPARISON.md). Written by the method developer; used to tune wording; never evaluation evidence.",
 "labelFields": {
  "expectByArm": "partial expect per camera arm (off, rgb, rgb_depth), merged over expect",
  "cameraMustCite": "capture times (s) the camera list must include",
  "cameraCiteOnly": "capture times the camera list may include",
  "authority": "report fact IDs (current hold or release) the answer must cite",
  "cameraSession": "recorded camera session (repository path) for the family"
 },
 "families": [
  {
   "id": "D2-01",
   "type": "visual-observation",
   "tests": "Camera and reports agree: vehicle on the stand, check pending.",
   "scenario": "LESSON-stand_clearance-17",
   "cameraSession": "outputs/checkpoint2-run/stand-b-session-observations.json",
   "turns": [
    {
     "cutoff": 40,
     "selected": {
      "aircraftId": "A3",
      "flightInstance": "TRN103"
     },
     "question": "Is the fuel vehicle still on Stand B?",
     "expect": {
      "status": [
       "answer"
      ],
      "referent": {
       "aircraftId": "A3",
       "flightInstance": "TRN103"
      },
      "mustCite": [
       "S006:movement_condition"
      ],
      "authority": [
       "S006:movement_condition"
      ]
     },
     "expectByArm": {
      "rgb": {
       "cameraMustCite": [
        40
       ]
      },
      "rgb_depth": {
       "cameraMustCite": [
        40
       ]
      }
     }
    }
   ]
  },
